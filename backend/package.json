{
  "name": "@stellar-estate/core-backend",
  "version": "1.0.0",
  "description": "Stellar Estate Financial Core Backend - APIs, PostgreSQL persistence, Stellar verification & reconciliation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "verify:types": "node ../scripts/verify-type-sync.mjs",
    "check:env": "node ../scripts/check-env.mjs",
    "test:contracts": "cargo test --manifest-path ../Cargo.toml --offline",
    "verify:all": "node ../scripts/run-all-checks.mjs",
    "audit:bundle": "node ../scripts/generate-audit-bundle.mjs",
    "verify:submission": "node ../scripts/pre-submission-check.mjs"
  },
  "keywords": [
    "stellar",
    "soroban",
    "real-estate",
    "fintech",
    "revenue-settlement"
  ],
  "author": "Stellar Estate Core Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "toml": "^5.0.1",
    "tinypool": "^2.2.0",
    "@vitest/mocker": "^4.1.12",
    "zod": "^4.6.7"
  }
}
